{
  "manifest_version": 3,
  "name": "Kick Yayın Bildirici",
  "version": "1.5.0",
  "description": "Seçtiğiniz Kick yayıncılarını anlık takip edin.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.kick.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:;"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kick Yayın Bildirici",
    "default_icon": "icon/icon.png"
  },
  "icons": {
    "16": "icon/icon.png",
    "48": "icon/icon.png",
    "128": "icon/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kick-notifier-firefox@insanmusti.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}